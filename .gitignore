# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Virtual environments
venv/
.venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Build / packaging artifacts
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Logs
*.log
logs/
training.log

# Local data artifacts
# Root-level only; do not ignore src/data/.
/data/
*.csv
*.parquet
*.feather
*.db
*.sqlite
*.sqlite3

# Model artifacts
# Root-level only; do not ignore src/models/.
/models/
*.pkl
*.joblib
*.h5
*.keras
*.onnx

# Allow example JSON config files if needed
!*.example.json

# Notebooks
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Coverage / test output
.coverage
coverage/
htmlcov/
test-results/
nosetests.xml

# IDE / editor files
.vscode/
.idea/
*.code-workspace

# OS metadata
.DS_Store
Thumbs.db

# Temporary / backup files
*.bak
*.swp
*.swo
*.tmp
*.temp
*~
*.orig

# Downloaded installers / archives
*.deb
*.zip
*.tar
*.tar.gz
*.tgz
